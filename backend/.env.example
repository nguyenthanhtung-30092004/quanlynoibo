PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change_me
DATABASE_NAME=quan_ly_noi_bo
# Chỉ bật true ở môi trường dev để TypeORM tự tạo bảng
DATABASE_SYNCHRONIZE=true

# Bắt buộc. Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=12h

# ---- Gửi tin nhắn cho khách (nút Gửi SMS / Gửi Zalo), qua eSMS (https://developers.esms.vn) ----
# true = chạy thử trong hệ thống: không gọi nhà cung cấp, chỉ ghi log, không đánh dấu "đã gửi".
# Chưa có khóa mà để false thì bấm gửi sẽ báo lỗi "Chưa cấu hình".
MESSAGING_DRY_RUN=true

# true = gọi eSMS thật nhưng ở chế độ Sandbox: không gửi tới điện thoại, không tính phí.
# Dùng để kiểm tra khóa và định dạng. Đổi về false khi gửi thật.
ESMS_SANDBOX=false

# Nhà cung cấp gửi SMS: speedsms hoặc esms (mặc định). Zalo luôn gửi qua eSMS ZNS.
SMS_PROVIDER=esms

# --- SpeedSMS (https://speedsms.vn) ---
# Token: connect.speedsms.vn > Settings > Profile
# --- VMG BrandSMS (SMS_PROVIDER=vmg). IP máy chủ phải được khai báo với VMG ---
VMG_TOKEN=
VMG_BRANDNAME=
VMG_BASE_URL=https://api.brandsms.vn/api
# Callback trạng thái: https://<domain>/api/orders/vmg-callback?secret=<VMG_CALLBACK_SECRET>
VMG_CALLBACK_SECRET=
# Zalo qua VMG: đặt ZALO_PROVIDER=vmg
ZALO_PROVIDER=
VMG_ZALO_TEMPLATE_ID=
VMG_ZALO_PARAMS=param1=customer_name,param2=route,param3=departure_time,param4=departure_date

SPEEDSMS_TOKEN=
# 2 = đầu số ngẫu nhiên (không cần Brandname), 3 = Brandname đã đăng ký,
# 4 = Brandname mặc định (Verify/Notify), 5 = gửi bằng app Android
SPEEDSMS_TYPE=2
# Tên Brandname (loại 3, 4) hoặc mã thiết bị (loại 5); loại 2 để trống
SPEEDSMS_SENDER=
# true = gửi có dấu (mỗi tin ít ký tự hơn), false = tự bỏ dấu
SPEEDSMS_UNICODE=false

# Khóa dùng chung cho SMS và Zalo (eSMS > Tài khoản > Cấu hình API)
ESMS_API_KEY=
ESMS_SECRET_KEY=

# --- SMS ---
# Bỏ trống = gửi tin đầu số cố định (SmsType 8): không cần đăng ký gì, bắt đầu ngay được.
# Có tên thương hiệu đã đăng ký = gửi tin brandname chăm sóc khách hàng (SmsType 2),
# khi đó nội dung phải khớp mẫu tin đã đăng ký với eSMS.
ESMS_BRANDNAME=
# Ghi đè loại tin nếu cần (thường để trống)
ESMS_SMS_TYPE=
# true = gửi có dấu (đắt hơn), false = tự bỏ dấu
ESMS_UNICODE=false

# --- Zalo (ZNS qua eSMS) ---
# Zalo OA đã liên kết với eSMS và mẫu ZNS đã duyệt
ESMS_ZALO_OAID=
ESMS_ZALO_TEMPID=
# Thứ tự các biến trong mẫu ZNS. Chọn trong: customer_name, route, departure_time, departure_date
ESMS_ZALO_PARAMS=customer_name,route,departure_time,departure_date
